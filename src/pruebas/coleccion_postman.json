              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "gestion_motocicletas",
                "api",
                "motocicletas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Kawasaki\",\n  \"modelo\": \"Z400\",\n  \"anio\": 2025,\n  \"cilindraje\": 399,\n  \"precio\": 28500000,\n  \"stock\": 2,\n  \"estado\": \"Disponible\"\n}",
              "options": {
