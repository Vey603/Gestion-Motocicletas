        {
          "name": "04. SOAP - Crear motocicleta válida (crearMotocicleta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.text();",
                  "const match = body.match(/<id_motocicleta>(\\d+)<\\/id_motocicleta>/);",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"id_soap\", match[1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              },
              {
                "key": "SOAPAction",
                "value": ""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ser=\"urn:MotocicletasService\">\n  <soap:Header/>\n  <soap:Body>\n    <ser:crearMotocicleta><marca>KTM</marca><modelo>Duke 200</modelo><anio>2025</anio><cilindraje>200</cilindraje><precio>16800000</precio><stock>3</stock><estado>Disponible</estado></ser:crearMotocicleta>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
